#
proba = model.predict_proba(X_test)
proba = proba.to_numpy()
proba1 = proba[:, 1]

# AUCROC
from sklearn import metrics
fpr, tpr, thresholds = metrics.roc_curve(y_test, proba1)
auc = metrics.roc_auc_score(y_test, proba1)
