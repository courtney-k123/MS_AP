print(f"model {model.name()} -> {metrics['str']}")

run.log({"Model Name": study_name})
run.log({"Model Type": "model 0.19 * (pca->feature_normalizer->data_cleanup->xgboost) + 0.38 * (pca->feature_normalizer->data_cleanup->random_forest) + 0.43 * (nop->maxabs_scaler->data_cleanup->lgbm) "})

# Predict Relapse Probabilities
model.fit(X_train, y_train)

#predict for only one efficacy if model trained on all
