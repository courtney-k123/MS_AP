                        num_iter=10, 
                        num_study_iter=5, 
                        metric = "aucroc", 
                        score_threshold = 0.5,
                        dataset=train_df_class, 
                        target= "RELAPSE_AT_5_YEAR", 
                        workspace= workspace)  # the label column in the dataset

