    (train_df_class['relapse'] == True) & (train_df_class['time_to_event_relapse'] < 1826),
    1,
    0
)

test_df_class.loc[:, 'RELAPSE_AT_5_YEAR'] = np.where(
    (test_df_class['relapse'] == True) & (test_df_class['time_to_event_relapse'] < 1826),
    1,
    0
)

