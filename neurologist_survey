def matches_numeric_criteria(p1, p2, p3, num_fields, tolerances):
    for field, tol in zip(num_fields, tolerances):
        values = [getattr(p1, field), getattr(p2, field), getattr(p3, field)]
        if max(values) - min(values) > tol:
            return False
    return True

def matches_symptom_rules(p1, p2, p3):
    # Severe symptoms
    def has_severe_symptom(p):
        return p.FIRST_SYMPTOM_BRAINTSTEM == 1 or p.FIRST_SYMPTOM_SPINAL_CORD == 1

    # Mild symptoms (for optional future use)
