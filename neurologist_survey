    return True


def find_custom_triplets(df):
    df = df[df['EFFICACY'].isin([1, 2, 3])]
    df['EFFICACY'] = df['EFFICACY'].astype(int)

    exact_match_cols = [
        'GENDER', 'OCB_MATCHED', 'OCB_UNMATCHED',
        'ANY_NEW_T2', 'NO_NEW_T2', 'ANY_ENHANCE',
        'CUM_T2_BIN', 'NUM_PREVIOUS_RELAPSES',
    ]
    
    num_fields = ['AGE_AT_TREATMENT', 'NO_MO_SINCE_LAST_RELAPSE', 'TIME_TO_TREAT']
    tolerances = [10, 6, 6]

    triplets = []

    # Group by exact match columns
    grouped = df.groupby(exact_match_cols, observed=False)

    for group_vals, group_df in grouped:
        eff1 = group_df[group_df['EFFICACY'] == 1]
        eff2 = group_df[group_df['EFFICACY'] == 2]
        eff3 = group_df[group_df['EFFICACY'] == 3]

        for p1, p2, p3 in product(eff1.itertuples(index=False),
                                  eff2.itertuples(index=False),
                                  eff3.itertuples(index=False)):
            
            # Apply relapse matching to all 3 pairs
            '''r1, r2, r3 = p1.NUM_PREVIOUS_RELAPSES, p2.NUM_PREVIOUS_RELAPSES, p3.NUM_PREVIOUS_RELAPSES
            if not (relapses_match(r1, r2) and relapses_match(r1, r3) and relapses_match(r2, r3)):
                continue'''
            
            if not (
                    edss_match(p1.EDSS, p2.EDSS) and
                    edss_match(p1.EDSS, p3.EDSS) and
                    edss_match(p2.EDSS, p3.EDSS)
                    ):
                continue
            
            s1, s2, s3 = p1.SEVERITY, p2.SEVERITY, p3.SEVERITY
            if not (
                    severity_match(s1, s2) and
                    severity_match(s1, s3) and
                    severity_match(s2, s3)
                    ):
                continue


            if not matches_numeric_criteria(p1, p2, p3, num_fields, tolerances):
                continue

            if not matches_symptom_rules(p1, p2, p3):
                continue

            triplets.append((p1, p2, p3))

    return triplets

