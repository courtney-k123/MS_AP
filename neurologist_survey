import pandas as pd
import numpy as np

def custom_match_long(source_group, target_group, id_col='id', n_matches=3, features=None):
    matches = []
    pair_id = 0

    source_group = source_group.copy()
    target_group = target_group.copy()

    # Custom bins for CUM_T2
    bins = [2, 5, 10, 20, 40, float('inf')]
    labels = ['2-5', '5-10', '10-20', '20-40', '50+']
    source_group['CUM_T2_BIN'] = pd.cut(source_group['CUM_T2'], bins=bins, labels=labels)
    target_group['CUM_T2_BIN'] = pd.cut(target_group['CUM_T2'], bins=bins, labels=labels)

    # Define severity matching logic
    severity_allowed = {
        0: [0],
        1: [1, 2],
        2: [1, 2, 3],
        3: [2, 3]
    }

    for _, src in source_group.iterrows():
        # Apply exact match filters first
        candidates = target_group[
            (target_group['GENDER'] == src['GENDER']) &
            (target_group['OCB_MATCHED'] == src['OCB_MATCHED']) &
            (target_group['OCB_UNMATCHED'] == src['OCB_UNMATCHED']) &
            (target_group['ANY_NEW_T2'] == src['ANY_NEW_T2']) &
            (target_group['NO_NEW_T2'] == src['NO_NEW_T2']) &
            (target_group['ANY_ENHANCE'] == src['ANY_ENHANCE']) &
            (target_group['CUM_T2_BIN'] == src['CUM_T2_BIN'])
        ].copy()

        # Apply range filters
        candidates = candidates[
            (np.abs(candidates['AGE_AT_TREATMENT'] - src['AGE_AT_TREATMENT']) <= 7) &
            (np.abs(candidates['NUM_PREVIOUS_RELAPSES'] - src['NUM_PREVIOUS_RELAPSES']) <= 1) &
            (np.abs(candidates['ARR_LAST_YEAR'] - src['ARR_LAST_YEAR']) <= 0.6) &
            (np.abs(candidates['EDSS'] - src['EDSS']) <= 1) &
            (np.abs(candidates['NO_MO_SINCE_LAST_RELAPSE'] - src['NO_MO_SINCE_LAST_RELAPSE']) <= 5) &
            (np.abs(candidates['TIME_TO_TREAT'] - src['TIME_TO_TREAT']) <= 5)
        ]

        # Apply flexible severity matching
        allowed_values = severity_allowed.get(src['SEVERITY'], [src['SEVERITY']])
        candidates = candidates[candidates['SEVERITY'].isin(allowed_values)]

        if candidates.empty:
            continue

        # Limit to n_matches randomly if too many candidates
        #candidates = candidates.sample(min(n_matches, len(candidates)), random_state=42)

        # Build long format output
        for _, tgt in candidates.iterrows():
            pair_id += 1
            src_row = src.copy()
            src_row['pair_id'] = pair_id
            src_row['role'] = 'source'
            matches.append(src_row)

            tgt_row = tgt.copy()
            tgt_row['pair_id'] = pair_id
            tgt_row['role'] = 'target'
            matches.append(tgt_row)

    matched_df = pd.DataFrame(matches)

    if features:
        cols = ['pair_id', 'role', id_col] + features
        matched_df = matched_df[cols]

    return matched_df


