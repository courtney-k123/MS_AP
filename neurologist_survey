def find_custom_doubles(df):
    df = df[df['EFFICACY'].isin([1, 2])]
    df['EFFICACY'] = df['EFFICACY'].astype(int)

    exact_match_cols = [
        'GENDER', 'OCB_MATCHED', 'OCB_UNMATCHED',
        'ANY_NEW_T2', 'NO_NEW_T2', 'ANY_ENHANCE',
        'CUM_T2_BIN', 'NUM_PREVIOUS_RELAPSES',
    ]
    
    num_fields = ['AGE_AT_TREATMENT', 'NO_MO_SINCE_LAST_RELAPSE', 'TIME_TO_TREAT']
    tolerances = [5, 6, 6]

    doubles = []

    grouped = df.groupby(exact_match_cols, observed=False)

    for group_vals, group_df in grouped:
        eff1 = group_df[group_df['EFFICACY'] == 1]
        eff2 = group_df[group_df['EFFICACY'] == 2]

        for p1, p2 in product(eff1.itertuples(index=False),
                              eff2.itertuples(index=False)):
            
            if not edss_match(p1.EDSS, p2.EDSS):
                continue
            
            if not severity_match(p1.SEVERITY, p2.SEVERITY):
                continue
            
            # New relapse rule
            '''if not relapses_match(p1.NUM_PREVIOUS_RELAPSES, p2.NUM_PREVIOUS_RELAPSES):
                continue'''

            if not matches_numeric_criteria(p1, p2, num_fields, tolerances):
                continue

            if not matches_symptom_rules(p1, p2):
                continue

            doubles.append((p1, p2))

    return doubles

