#finding matching triplets 
def build_triplets(matches_low_to_mod, matches_low_to_high, features, id_col='PATIENT_ID'):
    # Identify shared sources
    sources_low_to_mod = set(matches_low_to_mod.query("role == 'source'")[id_col])
    sources_low_to_high = set(matches_low_to_high.query("role == 'source'")[id_col])
    shared_sources = sources_low_to_mod.intersection(sources_low_to_high)

    triplets = []
    pair_id = 0

    for source_id in shared_sources:
        # Get source details (from one of the sets)
        source_details = matches_low_to_mod[
            (matches_low_to_mod[id_col] == source_id) & (matches_low_to_mod['role'] == 'source')
        ].iloc[0]

        # Get mod targets
        mod_targets = matches_low_to_mod[
            (matches_low_to_mod['role'] == 'target') &
            (matches_low_to_mod['pair_id'].isin(
                matches_low_to_mod[matches_low_to_mod[id_col] == source_id]['pair_id']
            ))
        ]

        # Get high targets
        high_targets = matches_low_to_high[
            (matches_low_to_high['role'] == 'target') &
            (matches_low_to_high['pair_id'].isin(
                matches_low_to_high[matches_low_to_high[id_col] == source_id]['pair_id']
            ))
        ]

        # Build triplets: source + each combination of mod & high target
        for _, mod_row in mod_targets.iterrows():
            for _, high_row in high_targets.iterrows():
                pair_id += 1
                # Append source
                triplets.append(
                    {'triplet_id': pair_id, 'role': 'source', **source_details[features].to_dict()}
                )
                # Append mod target
                triplets.append(
                    {'triplet_id': pair_id, 'role': 'target_mod', **mod_row[features].to_dict()}
                )
                # Append high target
                triplets.append(
                    {'triplet_id': pair_id, 'role': 'target_high', **high_row[features].to_dict()}
                )

    return pd.DataFrame(triplets)

