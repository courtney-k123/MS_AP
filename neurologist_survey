from collections import defaultdict
import random

def select_unique_patients(triplets_df, n_each=5, id_col='PATIENT_ID'):
    # Separate triplets into dict: triplet_id -> list of (role, treatment, PATIENT_ID)
    triplet_groups = triplets_df.groupby('triplet_id')

    triplet_data = {}
    for triplet_id, group in triplet_groups:
        triplet_data[triplet_id] = group[['role', 'EFFICACY', id_col]].to_dict('records')
    
    selected_patients = set()
    selected_final = []
    counts = defaultdict(int)  # track how many per treatment

    # Shuffle triplets for fairness
    triplet_ids = list(triplet_data.keys())
    random.shuffle(triplet_ids)

    for triplet_id in triplet_ids:
        candidates = triplet_data[triplet_id]
        
        # Sort candidates by which treatment we need more of
        candidates.sort(key=lambda x: counts[x['EFFICACY']])
        
        # Pick first available patient not used yet
        for cand in candidates:
            if cand[id_col] not in selected_patients and counts[cand['EFFICACY']] < n_each:
                selected_patients.add(cand[id_col])
                counts[cand['EFFICACY']] += 1
                selected_final.append({
                    'triplet_id': triplet_id,
                    'PATIENT_ID': cand[id_col],
                    'role': cand['role'],
                    'EFFICACY': cand['EFFICACY']
                })
                break

        # Stop if we have enough
        if all(c >= n_each for c in counts.values()):
            break

    return pd.DataFrame(selected_final), counts

selected_df, treatment_counts = select_unique_patients(triplets_df, n_each=5)

